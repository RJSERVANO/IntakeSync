<IfModule mod_rewrite.c>
    Options -Indexes
    RewriteEngine On

    # Never serve Laravel internals or mobile project files from public_html.
    RewriteRule ^backend/(?!public/).*$ - [F,L]
    RewriteRule ^(app|android|ios|node_modules|storage|database|routes|bootstrap|config|resources|tests|vendor)(/.*)?$ - [F,L]
    RewriteRule ^(\.git|\.github|\.env|composer\.(json|lock)|package(-lock)?\.json|app\.json|eas\.json|tsconfig\.json|metro\.config\.js)(/.*)?$ - [F,L]

    # Allow real files/assets that live in backend/public.
    RewriteCond %{REQUEST_URI} !^/backend/public/
    RewriteCond %{DOCUMENT_ROOT}/backend/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/backend/public/$1 -d
    RewriteRule ^(.*)$ backend/public/$1 [L]

    # Send all other requests to Laravel's public front controller.
    RewriteCond %{REQUEST_URI} !^/backend/public/
    RewriteRule ^(.*)$ backend/public/$1 [L]
</IfModule>
