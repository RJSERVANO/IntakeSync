{
  "expo": {
    "name": "IntakeSync",
    "slug": "IntakeSync",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/mainlogo.png",
    "scheme": "app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/mainlogo.png",
        "backgroundColor": "#1E3A8A"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/mainlogo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/mainlogo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1E3A8A"
        }
      ],
      "expo-web-browser",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
